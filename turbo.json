{
    "$schema": "https://turborepo.com/schema.json",
    "ui": "tui",
    "globalEnv": ["NODE_ENV"],
    "globalPassThroughEnv": [
        "APP_VERSION",
        "PORT",
        "CORS_ORIGIN",
        "DB_HOST",
        "DB_PORT",
        "DB_USER",
        "DB_PASSWORD",
        "DB_NAME",
        "REDIS_HOST",
        "REDIS_PORT",
        "REDIS_PASSWORD",
        "PROVIDERS_ENCRYPTION_KEY",
        "JWT_ACCESS_SECRET",
        "JWT_ACCESS_EXPIRES_IN",
        "JWT_REFRESH_SECRET",
        "JWT_REFRESH_EXPIRES_IN",
        "THROTTLE_TTL",
        "THROTTLE_LIMIT",
        "THROTTLE_STREAM_TTL",
        "THROTTLE_STREAM_LIMIT",
        "LOGS_MAX_LINES",
        "TELEMETRY_SLOW_MS",
        "TELEMETRY_SAMPLE_RATE"
    ],
    "tasks": {
        "build": {
            "dependsOn": ["^build"],
            "outputs": ["dist/**"]
        },
        "test": {
            "dependsOn": ["^build"],
            "outputs": ["coverage/**"]
        },
        "lint": {},
        "dev": {
            "cache": false,
            "persistent": true
        },
        "watch": {
            "cache": false,
            "persistent": true
        },
        "start": {
            "cache": false,
            "persistent": true
        },
        "start:debug": {
            "cache": false,
            "persistent": true
        },
        "start:prod": {
            "dependsOn": ["build"],
            "cache": false,
            "persistent": true
        }
    }
}
