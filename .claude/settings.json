{
  "permissions": {
    "allow": [
      "Bash(rtk find *)",
      "Bash(rtk grep *)",
      "Bash(rtk cat *)",
      "Bash(rtk git *)",
      "Bash(rtk pnpm *)",
      "Bash(rtk gh *)",
      "Bash(rtk sleep *)",
      "Bash(rtk ls *)",
      "Bash(rtk bash *)",
      "Bash(rtk wc *)",
      "Bash(rtk node *)",
      "Bash(rtk sed *)",
      "Bash(rtk docker *)",
      "Bash(rtk head *)",
      "Bash(rtk ng *)",
      "Bash(rtk sort *)",
      "Bash(rtk tail *)",
      "Bash(rtk xargs *)",
      "Bash(rtk cp *)",
      "Bash(rtk openspec *)",
      "Bash(rtk python3 *)",
      "WebFetch(domain:angular-demo.tailadmin.com)",
      "WebFetch(domain:www.npmjs.com)",
      "WebFetch(domain:angular.dev)",
      "WebFetch(domain:docs.nestjs.com)",
      "WebFetch(domain:openspec.dev)",
      "Bash(rtk rg *)",
      "Bash(rtk curl *)",
      "Bash(rtk which *)",
      "Bash(rtk realpath *)",
      "Bash(rtk env *)",
      "Bash(rtk tree *)",
      "Bash(rtk diff *)",
      "Bash(rtk du *)",
      "Bash(rtk jest *)",
      "Bash(rtk vitest *)",
      "Bash(rtk tsc *)",
      "Bash(rtk nest build)"
    ]
  },
  "enabledPlugins": {
    "typescript-lsp@gitpaas": true
  },
  "extraKnownMarketplaces": {
    "gitpaas": {
      "source": {
        "source": "directory",
        "path": "./.claude/plugins"
      }
    }
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/require-rtk.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
