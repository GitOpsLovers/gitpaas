# Production environment for the GitPaaS.
#
# Copy this file to `.env` in this directory and fill in real values
#

# ---- Images ----
IMAGE_TAG=latest

# ---- Host port bindings ----
BACKEND_PORT=3000
FRONTEND_PORT=8080

# ---- Backend runtime ----
NODE_ENV=production
PORT=3000
CORS_ORIGIN=http://localhost:8080
APP_BASE_URL=http://localhost:8080
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
THROTTLE_STREAM_TTL=60000
THROTTLE_STREAM_LIMIT=1000
LOGS_MAX_LINES=5000

# ---- PostgreSQL ----
POSTGRES_USER=gitpaas
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=gitpaas_db
DB_HOST=postgres
DB_PORT=5432
DB_USER=gitpaas
DB_PASSWORD=change-me-in-production
DB_NAME=gitpaas_db

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- Secrets ----
SECRETS_ENCRYPTION_KEY=

# ---- Docker ----
DOCKER_GID=999

# ---- JWT ----
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
