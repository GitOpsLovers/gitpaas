# Production environment for the GitPaaS.
#
# Copy this file to `.env` in this directory and fill in real values
#

# ---- Image build args ----
NODE_VERSION=26.1.0
PNPM_VERSION=11.1.3
IMAGE_TAG=latest

# ---- Host port bindings ----
BACKEND_PORT=3000
FRONTEND_PORT=8080

# ---- Backend runtime ----
NODE_ENV=production
PORT=3000
CORS_ORIGIN=http://localhost:8080
THROTTLE_TTL=60000
THROTTLE_LIMIT=100
THROTTLE_STREAM_TTL=60000
THROTTLE_STREAM_LIMIT=1000
LOGS_MAX_LINES=5000

# ---- PostgreSQL ----
POSTGRES_USER=gitpaas
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=gitpaas_db
DB_HOST=postgres
DB_PORT=5432
DB_USER=gitpaas
DB_PASSWORD=change-me-in-production
DB_NAME=gitpaas_db

# ---- Redis ----
# Hot store for the live deployment logs; PostgreSQL keeps the archive.
REDIS_HOST=redis
REDIS_PORT=6379
# Leave empty when the server needs no authentication.
REDIS_PASSWORD=

# ---- GitHub App ----
GITHUB_APP_ID=
# Base64-encoded PEM private key
GITHUB_APP_PRIVATE_KEY=
GITHUB_APP_INSTALLATION_ID=

# ---- Docker ----
DOCKER_GID=999

# ---- JWT ----
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
